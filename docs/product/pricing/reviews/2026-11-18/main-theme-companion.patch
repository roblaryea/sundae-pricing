 import { createContext, useContext, useEffect, useState, useCallback } from 'react';

 type Theme = 'dark' | 'light';
+
+// Share an explicit preference with pricing.sundae.io; keep the chosen dark default.
+function readTheme(): Theme {
+  if (typeof window === 'undefined') return 'dark';
+  try {
+    const shared = document.cookie.match(/(?:^|;\s*)sundae_theme=(light|dark)(?:;|$)/)?.[1];
+    if (shared === 'light' || shared === 'dark') return shared;
+  } catch { /* Preference storage can be unavailable. */ }
+  try { return localStorage.getItem('sundae-theme') === 'light' ? 'light' : 'dark'; } catch { return 'dark'; }
+}
+function saveTheme(theme: Theme) {
+  try { localStorage.setItem('sundae-theme', theme); } catch { /* Preference storage can be unavailable. */ }
+  const domain = location.hostname === 'sundae.io' || location.hostname.endsWith('.sundae.io') ? '; Domain=.sundae.io' : '';
+  try { document.cookie = `sundae_theme=${theme}; Path=/; Max-Age=31536000; SameSite=Lax${domain}${location.protocol === 'https:' ? '; Secure' : ''}`; } catch { /* Preference storage can be unavailable. */ }
+}
+

 interface ThemeContextValue {
   theme: Theme;
