{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/pricing/catalog/active",
      "destination": "https://app.sundaetech.ai/api/pricing/catalog/active"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<locale>ar|fr|es|de|nl|pt|hi|ur|it|pl|tr|zh-Hans|ja|ko|id|vi|ro|sv|bn|th|ms|az|ru|pap)"
        }
      ],
      "destination": "/localized/:locale/index.html"
    },
    {
      "source": "/simulator",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<locale>ar|fr|es|de|nl|pt|hi|ur|it|pl|tr|zh-Hans|ja|ko|id|vi|ro|sv|bn|th|ms|az|ru|pap)"
        }
      ],
      "destination": "/localized/:locale/simulator.html"
    },
    {
      "source": "/simulator",
      "destination": "/simulator.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
